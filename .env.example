# ── Required ──────────────────────────────────────────────────────────────

# DATABASE_URL: PostgreSQL connection string for Prisma ORM.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# If your password contains special characters (@, #, /, ?, etc.), the app
# will percent-encode it automatically - just paste the real password here.
DATABASE_URL="postgresql://username:password@localhost:5432/sohom_enterprises?schema=public"

# SITE_URL: canonical public origin used in metadata, sitemap.xml, and robots.txt.
SITE_URL="https://www.example.com"

# JWT_SECRET: secret key used to sign/verify auth session tokens.
# Required - the server will refuse to start without this set. Use a long,
# random value (e.g. `openssl rand -base64 48`). Never reuse the same value
# across environments, and never commit the real value anywhere.
JWT_SECRET="replace-with-a-long-random-value"

# NODE_ENV: set to "production" in your real deployment. Controls cookie
# security flags and disables dev-only auth shortcuts.
NODE_ENV="development"

# ── Business / payment info (optional but recommended) ─────────────────────
# Used on the checkout page and in contact info across the site. If left
# unset, the app shows clearly-marked placeholders like [BUSINESS PHONE]
# instead of inventing values.

# Set these to the exact UPI ID and payee name shown by your official QR.
UPI_VPA=""
UPI_PAYEE_NAME=""
BUSINESS_PHONE=""
BUSINESS_EMAIL=""
BUSINESS_ADDRESS=""

# ── Optional, currently unused unless configured ────────────────────────────
# The app runs fully without these (UPI QR + Cash on Delivery are the
# default payment methods). Set these only when you're ready to enable the
# corresponding feature; the app never requires them to function.

# Razorpay (optional online payment gateway, disabled unless both are set)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Cloudinary (optional image hosting for admin-uploaded product/service photos)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google OAuth (optional "Sign in with Google", not implemented in this phase)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend OTP email delivery
# Keep the API key private; set the real value only in your local .env or
# deployment environment. The onboarding sender is for permitted testing
# recipients only, not arbitrary customer addresses.
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM="Soham Enterprises <onboarding@resend.dev>"
# For production, verify your sending domain in Resend and replace RESEND_FROM
# with an address on that verified domain (for example: "Soham Enterprises <auth@yourdomain.com>").
